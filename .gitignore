# 依赖
node_modules/
.pnpm-store/

# 构建产物
dist/
build/
*.tsbuildinfo
.vite/

# 环境变量：绝不提交任何密钥
.env
.env.local
.env.*.local

# 模型资产：体积大，通过 pnpm models:fetch 获取，不入库
models/*.task
models/*.wasm
models/*.binarypb
models/downloads/

# 模型与 WASM 运行时资产（真实落盘位置）：由 pnpm models:fetch 与手动复制产生，不入库
apps/web/public/models/
apps/web/public/wasm/

# 真实视频与派生数据：含个人信息，见 docs/data-contracts.md
samples/
*.mp4
*.mov
*.avi
*.mkv
evaluation/fixtures/real/
evaluation/out/
# `evaluation/raw/` 曾出现在 docs/local-verification.md 的建议里（现已改成"放仓库外"）。
# 留着这条是**兜底**：视频有上面的扩展名规则挡着，但联系表/关键帧是 PNG ——
# 没这条的话，照旧建议放进去的图会被 `git add` 收进去，而那是**人脸的图**。
evaluation/raw/

# 运行时产物
*.log
logs/
coverage/

# 测试产物
test-results/
playwright-report/
blob-report/
.playwright/

# 排查用的临时截图 / 目录：随时可能被丢下，不该进仓库
# （踩过：我漏删了一个 .tmp-shot/，两张调试截图被误提交）
.tmp-*/
**/.tmp-*/

# 操作系统与编辑器
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
