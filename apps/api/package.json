{
  "name": "@pingpong/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Node/Fastify 后端：证据校验、知识选择、模型调用与输出校验",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --fileParallelism=false"
  },
  "dependencies": {
    "@fastify/static": "^8.0.4",
    "@pingpong/contracts": "workspace:*",
    "fastify": "^5.2.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
