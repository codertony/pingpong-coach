# 复制成 .env 后填写。.env 已被 .gitignore 忽略 —— **永远不要提交它**。
#
#   cp .env.example .env
#
# 放在**仓库根目录**（或 apps/api/ 下，两处都会找）。
# 这三个齐全才会进入 live 模式；缺一个会退回 mock，并且不报错 ——
# 所以配完**务必**用 /api/health 确认 modelMode 是 "live"。

# 必填（三者齐全才走 live）
MODEL_API_KEY=
MODEL_BASE_URL=https://api.deepseek.com
MODEL_ID=deepseek-flash

# 可选。不给就用代码里的默认值（括号里是依据，见 docs/evaluation-log.md）
# PORT=8787
# HOST=127.0.0.1
# MODEL_TIMEOUT_MS=15000          # 实测中位延迟约 3.9s
# MODEL_MAX_TOKENS=2000           # 推理模型会先花推理 token，太小会把正文截断
# MODEL_REASONING_EFFORT=         # 留空 = 不发送。实测**不设更省**，别填
