{
  "name": "pingpong-coach",
  "version": "0.1.0",
  "private": true,
  "description": "实时乒乓球训练反馈 MVP：摄像头 → 自动分组挥拍 → 二维动作测量与关键帧 → 一次多模态模型调用 → 一条有证据的反馈",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @pingpong/web dev",
    "dev:api": "pnpm --filter @pingpong/api dev",
    "dev:all": "pnpm -r --parallel --filter @pingpong/api --filter @pingpong/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @pingpong/web test:e2e",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm audit:wiring && pnpm test && pnpm build && pnpm check:bundle",
    "models:fetch": "node scripts/fetch-models.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "eval:replay": "node scripts/eval-replay.mjs",
    "clean": "pnpm -r exec rm -rf dist node_modules/.vite",
    "prepare": "husky",
    "audit:wiring": "node scripts/audit-wiring.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.2",
    "eslint": "^9.39.4",
    "eslint-plugin-boundaries": "^5.4.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^2.1.8"
  }
}
